# Copy to .env (never commit it). Token: Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Configure.
TUNNEL_TOKEN=
TZ=Europe/Madrid
# Optional: a long random secret. When set, only devices that opened https://<your-host>/editor?token=<it> once can change anything;
# everyone else sees a read-only app. Leave empty to let everybody edit.
# EDITOR_TOKEN=
# Optional: lets the Recap page write the championship's funny story with an LLM. Without a key the page only offers the prompt to copy.
# Free key: Google AI Studio (aistudio.google.com) - create it WITHOUT enabling billing so going over the free limits only errors, never charges.
# LLM_KEY=
# LLM_MODEL=gemini-flash-latest   # initial choice only: the model can be changed later in Config (saved in the database).
#   Google retires model names now and then; Config > Story generator lists the ones your key can use
# LLM_FALLBACK_MODEL=            # optional: tried once if the main model stays overloaded (503 high demand)
# LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai   # any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama...)
